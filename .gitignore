# Build output
boat-platform/build/

# Python
# setuptools leaves these behind on any `pip install` from the source tree
boat-platform/sdk/python/build/
boat-platform/cli/build/
**/__pycache__/
.claude/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# SQLite databases (runtime data)
*.db
*.db-shm
*.db-wal

# Generated test-suite reports (`boat test run` writes these next to the CWD)
reports/

# Recorded trace files (runtime data)
boat-platform/traces/
boat-platform/demo/traces/
traces/

# Capture-derived reverse-engineer PDU database outputs (generated, large)
boat-platform/config/*_pdu_db*.json

# Runtime state files
.last_import

# Local specification references (gitignored — symlink or copy your specs here)
spec/

# admin_gui session files -- personal saved setups, not repo content
admin_gui/session.yaml
admin_gui/session.yml
admin_gui/*.session.yaml
